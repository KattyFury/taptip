# Deployment URL cua app (VD: https://taptip.kattyfury1403.workers.dev)
NEXT_PUBLIC_SITE_URL=

# Circle API (https://console.circle.com/apikeys)
# CIRCLE_API_KEY: dung cho /api/wallet/balance (server). Build fail neu thieu.
CIRCLE_API_KEY=

# Circle Modular Wallets - Client Key (Web).
# Nho khai CUNG MOT domain o CA HAI cho tren Circle Console, neu khong passkey
# se bao "Invalid credentials" tren domain that:
#   1. Client Key -> Allowed Domain
#   2. Modular Wallets -> Configurator -> Passkey Domain
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=

# Resend - gui ma OTP dang nhap (dung key Sending access, khong dung Full access)
RESEND_API_KEY_SENDING=

# D1 + KV khai bang binding trong wrangler.jsonc, khong qua .env
