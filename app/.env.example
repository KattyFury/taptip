# Deployment URL cua app (VD: https://taptip.fun)
NEXT_PUBLIC_SITE_URL=

# --- Circle Developer-Controlled Wallets -----------------------------
# Lay tai https://console.circle.com/apikeys
# Ca 3 bien deu BAT BUOC: thieu la khong tao duoc vi, khong gui duoc tip.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# --- Resend (gui ma OTP dang nhap) -----------------------------------
# Dung key "Sending access", khong dung Full access.
RESEND_API_KEY_SENDING=

# Full access - chi can khi tao/verify domain gui mail, khong can de chay app.
RESEND_API_KEY_ADMIN=

# --- Cloudflare ------------------------------------------------------
# Dung cho `npm run cf:deploy` va sua DNS qua API.
# Luu vao .env.local (file do da nam trong .gitignore).
CLOUDFLARE_API_TOKEN=

# D1 + KV khai bang binding trong wrangler.jsonc, khong qua .env
